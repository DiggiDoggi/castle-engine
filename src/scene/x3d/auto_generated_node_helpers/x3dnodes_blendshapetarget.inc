class function TBlendShapeTargetNode.ClassX3DType: String;
begin
  Result := 'BlendShapeTarget';
end;

procedure TBlendShapeTargetNode.CreateNode;
begin
  inherited;

  FFdName := TSFString.Create(Self, True, 'name', '');
   FdName.ChangeAlways := chEverything;
  AddField(FFdName);

  FFdDeltaCoords := TMFVec3d.Create(Self, True, 'deltaCoords', []);
   FdDeltaCoords.ChangeAlways := chEverything;
  AddField(FFdDeltaCoords);

  FFdDeltaNormals := TMFVec3d.Create(Self, True, 'deltaNormals', []);
   FdDeltaNormals.ChangeAlways := chEverything;
  AddField(FFdDeltaNormals);

  FFdDeltaTangents := TMFVec4d.Create(Self, True, 'deltaTangents', []);
   FdDeltaTangents.ChangeAlways := chEverything;
  AddField(FFdDeltaTangents);

  FFdStatic := TSFBool.Create(Self, True, 'static', false);
   FdStatic.ChangeAlways := chEverything;
  AddField(FFdStatic);
end;

