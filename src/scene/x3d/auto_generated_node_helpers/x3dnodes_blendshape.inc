{ Automatically generated node properties.

  Do not edit this file manually!
  To add new properties:
  - add them to the text files in tools/internal/x3d-nodes-to-pascal/nodes-specification/ ,
  - and regenerate include files by running x3d-nodes-to-pascal }

{$ifdef read_interface}

  strict private
    function GetNameField: String;
    procedure SetNameField(const Value: String);
  public
    { Create node fields and events. }
    procedure CreateNode; override;
    class function ClassX3DType: String; override;

    strict private FFdName: TSFString;
    { Internal wrapper for property @code(NameField). This wrapper API may change, we advise to access simpler @code(NameField) instead, if it is defined (TODO: for now, some field types do not have a simpler counterpart). }
    public property FdName: TSFString read FFdName;
    { Optional name of this blend shape (morph) group. This can be any label,
    for example, 'Facial_expressions'. }
    property NameField: String read GetNameField write SetNameField;

    strict private FFdTargets: TMFNode;
    { Internal wrapper for property @code(Targets). This wrapper API may change, we advise to access simpler @code(Targets) instead, if it is defined (TODO: for now, some field types do not have a simpler counterpart). }
    public property FdTargets: TMFNode read FFdTargets;
    { List of blend shape targets. Each target defines one deformation that can be applied to the model. The final result is a mix of all active targets, even those loaded from other blend shape groups.

    In other tools, these are called morph targets (glTF) or shape keys (Blender). }
    procedure SetTargets(const Value: array of TBlendShapeTargetNode);

{$endif read_interface}

{$ifdef read_implementation}

{ TBlendShapeNode ----------------------------------------------- }

function TBlendShapeNode.GetNameField: String;
begin
  Result := FdName.Value;
end;

procedure TBlendShapeNode.SetNameField(const Value: String);
begin
  FdName.Send(Value);
end;

procedure TBlendShapeNode.SetTargets(const Value: array of TBlendShapeTargetNode);
var
  L: Integer;
  A: array of TX3DNode;
begin
  L := High(Value) + 1;
  SetLength(A, L);
  if L > 0 then
    Move(Value[0], A[0], L * SizeOf(TBlendShapeTargetNode));
  FdTargets.Send(A);
end;

class function TBlendShapeNode.ClassX3DType: String;
begin
  Result := 'BlendShape';
end;

procedure TBlendShapeNode.CreateNode;
begin
  inherited;

  FFdName := TSFString.Create(Self, True, 'name', '');
   FdName.ChangeAlways := chEverything;
  AddField(FFdName);

  FFdTargets := TMFNode.Create(Self, True, 'targets', [TBlendShapeTargetNode]);
   FdTargets.ChangeAlways := chEverything;
  AddField(FFdTargets);
end;

{$endif read_implementation}
